# Supabase credentials. Locally, take them from `npx supabase status` at the repo root.
# Both values are public by design; row-level security is what protects data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: where server actions reach the Python agent.
AGENT_URL=http://127.0.0.1:8000
