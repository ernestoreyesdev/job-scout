# Local values come from `npx supabase status --workdir infra` at the repo root.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security; never expose it to the web app.
SUPABASE_SERVICE_ROLE_KEY=
# Encrypts users' API keys at rest. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_ENCRYPTION_KEY=
# Optional. Anthropic key used when none is saved in the app.
ANTHROPIC_API_KEY=
# Optional. Resend key for email; without it emails are only logged.
RESEND_API_KEY=
# Sender for emails. onboarding@resend.dev only reaches your own Resend account address until a domain is verified.
EMAIL_FROM=Job Scout <onboarding@resend.dev>
# Optional. Where admin alerts go.
ADMIN_EMAIL=
